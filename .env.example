# Настройки платформы CardioAI.
# Скопируйте этот файл в .env и измените нужные значения.
# Строки, начинающиеся с #, — комментарии; незаданные параметры берут значения по умолчанию.

# Ключ подписи сессий. Если не задан, создаётся автоматически и хранится в instance/secret_key.
# На хостинге задайте длинную случайную строку, например результат команды:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# База данных. По умолчанию — файл instance/cardioai.db (SQLite).
# Для PostgreSQL установите драйвер (pip install "psycopg[binary]") и укажите:
# DATABASE_URL=postgresql+psycopg://пользователь:пароль@сервер:5432/cardioai

# Адрес сайта, по которому его открывают пользователи (нужен для ссылок в письмах и сертификатах).
# BASE_URL=http://localhost:8000

# true, если сайт работает по HTTPS: cookie сессии будет передаваться только по защищённому каналу.
# COOKIE_SECURE=false

# Срок жизни сессии в днях.
# SESSION_DAYS=14

# Регистрация: invite — только по коду приглашения (по умолчанию), open — свободная.
# REGISTRATION_MODE=invite

# Откуда браузер загружает Python для практических уроков.
# По умолчанию — CDN jsDelivr. Для работы без интернета выполните
#   python scripts/fetch_pyodide.py
# и раскомментируйте строку:
# PYODIDE_BASE_URL=/static/vendor/pyodide/

# Правила тестов.
# QUIZ_PASS_PERCENT=80
# QUIZ_MAX_ATTEMPTS=3
# QUIZ_COOLDOWN_HOURS=24

# Почта для сброса пароля. auto — отправлять через SMTP, если задан SMTP_HOST;
# console — печатать письма в окно сервера (удобно для проверки); none — отключить.
# MAIL_BACKEND=auto
# SMTP_HOST=smtp.example.ru
# SMTP_PORT=587
# SMTP_USER=cardioai@example.ru
# SMTP_PASSWORD=
# SMTP_FROM=CardioAI <cardioai@example.ru>
# SMTP_STARTTLS=true
